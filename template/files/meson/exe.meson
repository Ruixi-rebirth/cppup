project(
  '{{.ProjectName}}',
  'cpp',
  version : '{{.Version}}',
  meson_version : '>= {{.MinVersion}}',
  default_options : [
    'warning_level=3',
    'cpp_std=c++{{.CxxStd}}',
  ]
)

# Dependencies: dependency() prefers system libs (pkg-config/cmake) for faster builds.
# Use 'fallback' to automatically build from subprojects/ if the system lib is missing.
# Example: fmt_dep = dependency('fmt', fallback: ['fmt', 'fmt_dep'])

inc = include_directories('include')

executable('{{.ProjectName}}',
  'src/main.cpp',
  # dependencies : [fmt_dep],
  include_directories : inc,
  install : true,
)
{{- if .WithTests}}

subdir('tests')
{{- end}}
