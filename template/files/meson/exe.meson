project(
  '{{.ProjectName}}',
  'cpp',
  version : '{{.Version}}',
  meson_version : '>= {{.MinVersion}}',
  default_options : [
    'warning_level=3',
    'cpp_std=c++{{.CxxStd}}',
  ]
)

# Dependencies: use dependency() for pkg-config/cmake packages, or subproject() for wraps.
# Example: fmt_dep = dependency('fmt', fallback: ['fmt', 'fmt_dep'])

executable('{{.ProjectName}}',
  'src/main.cpp',
  # dependencies : [fmt_dep],
  include_directories : include_directories('include'),
  install : true,
)
{{- if .WithTests}}

subdir('tests')
{{- end}}
